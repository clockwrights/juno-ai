{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:juno:contracts:model-request",
  "title": "gate-model request (OpenAI-compatible subset, ADR-28)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "stage",
    "issued_at",
    "role",
    "system",
    "messages",
    "max_tokens"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,24}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "role": {
      "enum": [
        "conversation",
        "heartbeat",
        "consolidation",
        "supervisor",
        "canary"
      ]
    },
    "system": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "stable"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "stable": {
            "type": "boolean"
          }
        }
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16000
    },
    "response_format": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "not": {
    "required": [
      "model"
    ]
  }
}
