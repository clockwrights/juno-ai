{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:juno:contracts:embed-request",
  "title": "gate-model embed request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "stage",
    "issued_at",
    "role",
    "texts"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,24}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "role": {
      "const": "embed"
    },
    "texts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "maxLength": 8192
      }
    }
  },
  "not": {
    "required": [
      "model"
    ]
  }
}
