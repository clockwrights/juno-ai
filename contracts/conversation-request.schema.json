{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:juno:contracts:conversation-request",
  "title": "agent-conversation invocation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "stage",
    "issued_at",
    "mode",
    "channel",
    "conversation_id",
    "message",
    "budgets"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,24}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "live",
        "canary"
      ]
    },
    "channel": {
      "enum": [
        "telegram",
        "panel"
      ]
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "text",
        "received_at"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notifications_remaining",
        "tokens_remaining_today"
      ],
      "properties": {
        "notifications_remaining": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_remaining_today": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
