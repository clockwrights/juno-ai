{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:juno:contracts:tools:diary_read",
  "title": "tool diary_read",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_n"
      ],
      "properties": {
        "last_n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sk",
              "content"
            ],
            "properties": {
              "sk": {
                "type": "string"
              },
              "content": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
