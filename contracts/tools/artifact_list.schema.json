{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:juno:contracts:tools:artifact_list",
  "title": "tool artifact_list",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefix"
      ],
      "properties": {
        "prefix": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
