{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:juno:contracts:tools:run_code",
  "title": "tool run_code",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "timeout_s",
        "stdin"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "timeout_s": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 60
        },
        "stdin": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdout",
        "stderr",
        "exit_code",
        "duration_ms",
        "truncated",
        "killed"
      ],
      "properties": {
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "killed": {
          "type": "boolean"
        }
      }
    }
  }
}
