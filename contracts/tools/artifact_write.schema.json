{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:juno:contracts:tools:artifact_write",
  "title": "tool artifact_write",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content",
        "etag"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "etag": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "output": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "etag"
          ],
          "properties": {
            "etag": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "enum": [
                "conflict",
                "path_not_allowed"
              ]
            }
          }
        }
      ]
    }
  }
}
