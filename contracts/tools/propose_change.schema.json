{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:juno:contracts:tools:propose_change",
  "title": "tool propose_change",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "rationale",
        "diff"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "rationale": {
          "type": "string"
        },
        "diff": {
          "type": "string",
          "maxLength": 204800
        }
      }
    },
    "output": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proposal_id"
          ],
          "properties": {
            "proposal_id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "enum": [
                "proposals_disabled",
                "disabled_in_canary"
              ]
            }
          }
        }
      ]
    }
  }
}
