{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:juno:contracts:tools:proposal_status",
  "title": "tool proposal_status",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id"
      ],
      "properties": {
        "proposal_id": {
          "type": "string"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "title",
        "status",
        "created_at",
        "updated_at",
        "pr_url",
        "rejection_reason"
      ],
      "properties": {
        "proposal_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "enum": [
            "submitted",
            "rejected_path",
            "pr_open",
            "gate_failed",
            "approved",
            "closed",
            "deploying",
            "deployed",
            "rolled_back"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "pr_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "rejection_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
