{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:juno:contracts:heartbeat-response",
  "title": "agent-heartbeat invocation response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "stage",
    "issued_at",
    "invocation_id",
    "outcome",
    "summary",
    "diary_entry_sk",
    "next_wake_wish_minutes",
    "usage",
    "tool_calls",
    "memory_ops",
    "artifacts_touched"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,24}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "invocation_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "outcome": {
      "enum": [
        "did_nothing",
        "worked",
        "error"
      ]
    },
    "summary": {
      "type": "string"
    },
    "diary_entry_sk": {
      "type": "string"
    },
    "next_wake_wish_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 15,
      "maximum": 1440
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "cached_tokens",
        "model_calls"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "model_calls": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "ok",
          "duration_ms"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "memory_ops": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "saved",
        "updated",
        "forgotten"
      ],
      "properties": {
        "saved": {
          "type": "integer",
          "minimum": 0
        },
        "updated": {
          "type": "integer",
          "minimum": 0
        },
        "forgotten": {
          "type": "integer",
          "minimum": 0
        },
        "consolidated": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifacts_touched": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
