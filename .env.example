# Copy to `.env` (gitignored) and fill in. Never commit `.env`.
# Read by ops/localenv.py, so `make`, `npx cdk` and every script agree.

# The AWS account the stacks deploy to (ADR-37). Required for a deploy;
# without it synthesis uses a placeholder that cannot be deployed.
JUNO_AWS_ACCOUNT=123456789012

# Optional. Must offer S3 Vectors and Lambda arm64. Default: eu-central-1.
# JUNO_AWS_REGION=eu-central-1
